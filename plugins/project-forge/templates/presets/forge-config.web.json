{
  "verifyCommand": "pnpm verify",
  "verifyTimeoutSec": 600,
  "aliases": {
    "@/": "src/"
  },
  "layers": {
    "ui": [
      "src/app",
      "src/components",
      "src/ui"
    ],
    "logic": [
      "src/features",
      "src/domain",
      "src/hooks"
    ],
    "network": [
      "src/services",
      "src/api"
    ],
    "data": [
      "src/data",
      "src/db"
    ]
  },
  "forbidden": {
    "ui": [
      "network",
      "data"
    ],
    "logic": [
      "ui"
    ],
    "network": [
      "ui",
      "logic"
    ],
    "data": [
      "ui",
      "logic",
      "network"
    ]
  },
  "design": {
    "tokensFiles": [
      "src/ui/theme/tokens.ts",
      "src/ui/theme/tokens.css"
    ],
    "checkDirs": [
      "src/app",
      "src/components",
      "src/ui"
    ],
    "extensions": [
      ".tsx",
      ".jsx",
      ".css",
      ".scss"
    ],
    "ignore": [
      ".test.",
      ".spec.",
      ".stories."
    ],
    "allow": []
  }
}
